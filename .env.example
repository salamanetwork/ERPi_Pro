# Django Core Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (SQLite default for local dev; override for PostgreSQL/MySQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Frontend / Vite / API Settings
VITE_API_BASE_URL=http://127.0.0.1:8000/api
DEFAULT_LOCALE=en

# Production Security Defaults (enable when deploying behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
