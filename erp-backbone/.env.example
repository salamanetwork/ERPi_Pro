# Copy to .env.staging or .env.production, chmod 600, and set independent values.
COMPOSE_PROJECT_NAME=erp-staging
ERP_RELEASE=2.10.1
ERP_APP_MODE=production
ERP_HOST=localhost
ERP_AUTHORITY=localhost:8443
ERP_BIND_ADDRESS=127.0.0.1
ERP_HTTP_PORT=8080
ERP_HTTPS_PORT=8443
ERP_TLS_DIR=./tls/staging
ERP_SECRET_KEY=CHANGE_ME_DJANGO
ERP_MFA_KEY=CHANGE_ME_MFA
ERP_POSTGRES_PASSWORD=CHANGE_ME_DB_ADMIN
ERP_DB_PASSWORD=CHANGE_ME_DB_APP
ERP_INITIAL_DB_NAME=erp_backbone
ERP_DB_NAME=erp_backbone
ERP_MEDIA_SUBDIR=live
ERP_HSTS_PRELOAD=0
ERP_MFA_ALL=0
ERP_MFA_ROLES=
ERP_WEB_WORKERS=3
ERP_WEB_THREADS=2
ERP_SMTP_ENABLED=0
ERP_SMTP_HOST=localhost
ERP_SMTP_PORT=587
ERP_SMTP_USER=
ERP_SMTP_PASSWORD=
ERP_SMTP_FROM=erp@localhost
ERP_SMTP_TLS=1
# Comma-separated trusted Django app packages included in the image.
ERP_EXTRA_EXTENSIONS=

# Marketing live channels are disabled by default. WSL uses Mailpit.
ERP_MARKETING_LIVE=0
ERP_MARKETING_PUBLIC_URL=https://erp.example.com
ERP_MARKETING_HMAC_KEY=
ERP_MARKETING_TEST_RECIPIENTS=
ERP_MARKETING_RATE_EMAIL=10
ERP_MARKETING_RATE_SMS=10
ERP_MARKETING_RATE_WHATSAPP=10
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ERP_TWILIO_ACCOUNT_SID=
ERP_TWILIO_AUTH_TOKEN=

# Generate a separate, persistent random key; do not reuse the staff SECRET_KEY.
ERP_CUSTOMER_JWT_KEY=
ERP_PUBLIC_BASE_URL=https://erp.example.com
ERP_CONNECTOR_KEY=
