# Separate shell configuration. Copy for each environment, chmod 600.
RESTIC_REPOSITORY=s3:https://s3.example.net/erp-staging
RESTIC_PASSWORD_FILE=/secure/erp/staging-restic-password
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Optional STS credentials and private CA for an S3-compatible destination.
# AWS_SESSION_TOKEN=
# RESTIC_CACERT=/secure/erp/s3-ca.pem
